{
  "name": "hydraboost",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "build:static": "ng build --configuration production,static",
    "postbuild:static": "node tools/prepare-static-build.mjs",
    "audit:static": "node tools/audit-static-build.mjs",
    "preview:static": "node tools/serve-static-preview.mjs",
    "build:dev": "ng build --configuration development",
    "lint": "npx tsc --noEmit -p tsconfig.app.json && npx tsc --noEmit -p tsconfig.spec.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "npm run build:static && npm run audit:static && playwright test",
    "serve:ssr": "node dist/Hydraboost/server/server.mjs",
    "audit:http": "node tools/audit-http.mjs",
    "serve:contact": "php -S 127.0.0.1:8081 tools/contact-router.php",
    "test:contact": "php tests/contact/handler.test.php",
    "test:contact:http": "node --test tests/contact/http.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
