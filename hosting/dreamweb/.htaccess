Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteOptions AllowNoSlash

  # One canonical host: HTTPS without www.
  RewriteCond %{HTTP_HOST} !^hydraboost-infuzije\.rs$ [NC]
  RewriteRule ^ https://hydraboost-infuzije.rs%{REQUEST_URI} [R=301,L,NE]

  # X-Forwarded-Proto prevents an HTTPS loop when Cloudflare proxies the request.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://hydraboost-infuzije.rs%{REQUEST_URI} [R=301,L,NE]

  # Preserve the permanent legacy redirects from the Angular router.
  RewriteRule ^cjenovnik/?$ https://hydraboost-infuzije.rs/cenovnik [R=301,L]
  RewriteRule ^our-services/?$ https://hydraboost-infuzije.rs/usluge [R=301,L]
  RewriteRule ^about-us/?$ https://hydraboost-infuzije.rs/o-nama [R=301,L]
  RewriteRule ^contact/?$ https://hydraboost-infuzije.rs/kontakt [R=301,L]

  # Keep canonical route URLs without a trailing slash.
  RewriteRule ^(usluge|cenovnik|o-nama|faq|kontakt)/$ https://hydraboost-infuzije.rs/$1 [R=301,L]

  # Serve each prerendered page without exposing /index.html in its URL.
  RewriteRule ^(usluge|cenovnik|o-nama|faq|kontakt)$ $1/index.html [END]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:avif|webp|jpg|jpeg|png|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
